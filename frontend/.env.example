NEXT_PUBLIC_API_URL=http://localhost:4000

# Clé Google AI Studio (Gemini) - lue uniquement côté serveur, ne jamais préfixer par NEXT_PUBLIC_.
# Sans clé, l'IA est simulée localement.
GEMINI_API_KEY=

# Facultatif : modèles essayés dans l'ordre, séparés par des virgules.
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
